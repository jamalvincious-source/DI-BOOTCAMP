<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container my-4">
  <h2>Search Posts</h2>

  <form action="/search/title" method="POST" class="mb-4">
    <div class="input-group">
      <input type="text" name="title" class="form-control" placeholder="Search by title" />
      <button type="submit" class="btn btn-primary">Search by Title</button>
    </div>
  </form>

  <form action="/search/category" method="POST">
    <div class="input-group">
      <select name="category" class="form-select">
        <option value="">Choose category</option>
        <option value="Science">Science</option>
        <option value="History">History</option>
        <option value="Animals">Animals</option>
        <option value="Nature">Nature</option>
      </select>
      <button type="submit" class="btn btn-success">Search by Category</button>
    </div>
  </form>
</div>

<%- include('../partials/posts') %>
<%- include('../partials/footer') %>
