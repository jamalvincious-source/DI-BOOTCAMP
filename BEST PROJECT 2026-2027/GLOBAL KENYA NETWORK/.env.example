DATABASE_URL="postgresql://postgres:your_password@localhost:5432/global_network_kenya?schema=public"
JWT_SECRET="replace_with_a_unique_random_secret_of_at_least_32_characters"
PORT=3000
HOST=localhost
NODE_ENV=development
# Public website origin used in email links. For local VS Code Live Server:
FRONTEND_BASE_URL=http://localhost:5500

# The backend provisions this Super Admin account on startup. Password must be unique and at least 12 characters.
# Keep your real .env private; never commit or share the password.
# After changing the Prisma schema, run `npm run prisma:generate` and `npm run db:push`.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SMTP is required for password-reset links and Super Admin email sign-in codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional shared secret for a trusted payment-provider verification service.
# This does not enable checkout or verify payments by itself.
PAYMENT_CALLBACK_SECRET=
