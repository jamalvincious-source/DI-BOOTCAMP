// 1. Declare a global variable named allBoldItems.
let allBoldItems = [];

// 2. Create a function called getBoldItems() that collects all bold items and assigns them to the variable.
function getBoldItems() {
    allBoldItems = document.querySelectorAll("#text-paragraph strong");
}

// Run it once to populate the variable
getBoldItems();

// 3. Create a function called highlight() that changes the color of all bold text to blue.
function highlight() {
    getBoldItems();
    allBoldItems.forEach(item => {
        item.style.color = "blue";
    });
}

// 4. Create a function called returnItemsToDefault() that changes the color back to black.
function returnItemsToDefault() {
    getBoldItems();
    allBoldItems.forEach(item => {
        item.style.color = "black";
    });
}

// 5. Call highlight() on mouseover and returnItemsToDefault() on mouseout of the paragraph.
const paragraph = document.getElementById("text-paragraph");

if (paragraph) {
    paragraph.addEventListener("mouseover", highlight);
    paragraph.addEventListener("mouseout", returnItemsToDefault);
}